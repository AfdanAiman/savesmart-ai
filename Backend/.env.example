# Salin menjadi .env lalu sesuaikan
PORT=4000
# WAJIB diganti saat production (string acak panjang, minimal 32 karakter)
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES=7d
# Asal frontend yang diizinkan, pisahkan dengan koma
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# true = akun baru langsung diisi data contoh (berguna untuk demo), false untuk production
SEED_ON_REGISTER=true
# mock = hasil OCR contoh | service = teruskan foto ke layanan AI (ocr/ai-service)
OCR_MODE=mock
OCR_SERVICE_URL=http://localhost:5000/scan
